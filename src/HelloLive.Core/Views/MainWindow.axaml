<Window
    x:Class="HelloLive.Core.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HelloLive.Core.ViewModels"
    xmlns:controls="using:HelloLive.Core.Controls"
    x:DataType="vm:MainWindowViewModel"
    Title="HelloLive"
    Icon="avares://HelloLive.Core/Assets/app-icon.ico"
    Width="1500"
    Height="920"
    MinWidth="1080"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    CanResize="True"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    TransparencyBackgroundFallback="Transparent">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.metricCard">
      <Setter Property="Background" Value="{DynamicResource CardColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="Background" Value="{DynamicResource InputColor}" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C3AED" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.coral">
      <Setter Property="Background" Value="#FD6F71" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.windowButton">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.windowButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource WindowButtonHoverColor}" />
    </Style>
    <Style Selector="Button.windowButton.closeButton:pointerover">
      <Setter Property="Background" Value="#E5484D" />
    </Style>
    <Style Selector="ListBox.monitorList ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,18,10" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.monitorList ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.monitorAction">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.monitorAction.check">
      <Setter Property="Background" Value="#187C3AED" />
      <Setter Property="Foreground" Value="#7C3AED" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.monitorAction.danger">
      <Setter Property="Foreground" Value="#EF4444" />
    </Style>
  </Window.Styles>

  <Border Margin="1"
          CornerRadius="8"
          ClipToBounds="True"
          Background="{DynamicResource PageBackgroundColor}"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1">
    <Grid RowDefinitions="74,*">
      <Border Grid.RowSpan="2">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#5B21B6" Offset="0" />
            <GradientStop Color="#BE185D" Offset="0.48" />
            <GradientStop Color="#0369A1" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Grid.RowSpan="2" Background="{DynamicResource BackgroundOverlayColor}" />

      <Grid Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            Background="{DynamicResource TitleBarColor}"
            Panel.ZIndex="100">
        <Grid Grid.Column="0"
              Margin="18,8,10,8"
              ColumnDefinitions="54,Auto"
              ColumnSpacing="12"
              VerticalAlignment="Center"
              PointerPressed="TitleBar_PointerPressed">
          <Border Width="50"
                  Height="50"
                  CornerRadius="10"
                  Background="#28FFFFFF"
                  Padding="4"
                  ClipToBounds="True">
            <controls:LiveLogo />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="HelloLive" FontSize="23" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Avalonia + Playwright · 多平台直播监控" FontSize="12" Foreground="#DFFFFFFF" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="Transparent" PointerPressed="TitleBar_PointerPressed" />

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="0"
                    Margin="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
          <Button Classes="windowButton"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="切换主题">
            <TextBlock Text="{Binding ThemeIcon}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Button>
          <Button Classes="windowButton"
                  Command="{Binding ToggleMonitorPanelCommand}"
                  ToolTip.Tip="{Binding MonitorPanelButtonText}">
            <Grid Width="16" Height="16">
              <Border BorderBrush="White"
                      BorderThickness="1.5"
                      CornerRadius="2" />
              <Border Width="1.5"
                      Height="11"
                      Margin="0,0,3,0"
                      Background="White"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Classes="windowButton" Click="MinimizeButton_Click" ToolTip.Tip="最小化">
            <Viewbox Width="14" Height="14" Stretch="Uniform">
              <Path Data="M 1,7 L 13,7"
                    Stroke="White"
                    StrokeThickness="1.5"
                    StrokeLineCap="Round" />
            </Viewbox>
          </Button>
          <Button Classes="windowButton" Click="MaximizeButton_Click" ToolTip.Tip="最大化/还原">
            <Viewbox Width="14" Height="14" Stretch="Uniform">
              <Rectangle Width="10"
                         Height="10"
                         Stroke="White"
                         StrokeThickness="1"
                         Fill="Transparent" />
            </Viewbox>
          </Button>
          <Button Classes="windowButton closeButton" Click="CloseButton_Click" ToolTip.Tip="关闭">
            <Viewbox Width="14" Height="14" Stretch="Uniform">
              <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                    Stroke="White"
                    StrokeThickness="1.5"
                    StrokeLineCap="Round" />
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1"
            Margin="20,14,8,20"
            ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0"
              Margin="0,0,8,0"
              ColumnDefinitions="410,*"
              ColumnSpacing="16">
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="0,0,4,0">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="添加监控" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Classes="caption"
                             Text="可直接粘贴“文本 + URL + 文本”的分享内容；HelloLive 会自动提取 URL、跟随短链重定向，并统一保存为 live.kuaishou.com/profile/{作者标识}。"
                             TextWrapping="Wrap" />
                  <TextBox Text="{Binding NewMonitorUrl, Mode=TwoWay}"
                           PlaceholderText="粘贴主页地址、短链或完整分享文本"
                           MinHeight="42" />
                  <TextBox Text="{Binding NewMonitorName, Mode=TwoWay}"
                           PlaceholderText="备注名称（可选）"
                           MinHeight="42" />
                  <Button Classes="coral"
                          Content="加入监控列表"
                          Command="{Binding AddMonitorCommand}" />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="浏览器" FontSize="18" FontWeight="SemiBold" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="监控探测：无头模式" FontWeight="Medium" />
                    <TextBlock Classes="caption"
                               Text="监控列表中的作者始终使用后台 Chromium 探测，不显示浏览器窗口；轮询和“立即检查”都不会弹出 Chrome。"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <CheckBox Content="阻止图片和字体，降低页面资源占用"
                            IsChecked="{Binding BlockImagesAndFonts, Mode=TwoWay}" />
                  <Button Content="安装 / 更新 Chromium"
                          Command="{Binding InstallChromiumCommand}" />
                  <TextBlock Classes="caption"
                             Text="{Binding BrowserStatusText}"
                             TextWrapping="Wrap" />
                  <StackPanel IsVisible="{Binding IsChromiumInstallProgressVisible}" Spacing="5">
                    <ProgressBar Minimum="0" Maximum="100" Height="8"
                                 IsIndeterminate="{Binding IsChromiumInstallProgressIndeterminate}"
                                 Value="{Binding ChromiumInstallProgressPercent}" />
                    <TextBlock Classes="caption" Text="{Binding ChromiumInstallProgressText}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="监控策略" FontSize="18" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="最大并发页面" FontWeight="Medium" />
                      <TextBlock Classes="caption" Text="建议 3～5；默认 4。" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1"
                                   Minimum="1" Maximum="8" Increment="1"
                                   Value="{Binding MaxConcurrentPages, Mode=TwoWay}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="轮询间隔（秒）" FontWeight="Medium" />
                      <TextBlock Classes="caption" Text="每轮完成后等待再检查。" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1"
                                   Minimum="10" Maximum="3600" Increment="10"
                                   Value="{Binding CheckIntervalSeconds, Mode=TwoWay}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="单页超时（秒）" FontWeight="Medium" />
                      <TextBlock Classes="caption" Text="页面未发现流时结束本次检查。" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1"
                                   Minimum="5" Maximum="120" Increment="5"
                                   Value="{Binding CheckTimeoutSeconds, Mode=TwoWay}" />
                  </Grid>
                  <CheckBox Content="启动 HelloLive 后自动开始监控"
                            IsChecked="{Binding AutoStartMonitoring, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Classes="coral"
                            MinHeight="40"
                            Content="开始监控"
                            Command="{Binding StartMonitoringCommand}" />
                    <Button Grid.Column="1"
                            MinHeight="40"
                            Content="停止监控"
                            Command="{Binding StopMonitoringCommand}" />
                    <Button Grid.Column="2"
                            Classes="primary"
                            MinHeight="40"
                            Content="立即检查全部"
                            Command="{Binding CheckAllCommand}" />
                  </Grid>
                  <TextBlock Classes="caption"
                             Text="每个检查只临时创建 Page；抓到 FLV/HLS 后立即中止浏览器媒体下载并关闭 Page，录制器会用独立连接实时落盘。"
                             TextWrapping="Wrap" />
                  <Border Height="1" Margin="0,3" Background="{DynamicResource BorderColor}" />
                  <TextBlock Text="直播录像目录" FontWeight="Medium" />
                  <TextBlock Classes="caption"
                             Text="{Binding DownloadRoot}"
                             TextWrapping="Wrap" />
                  <Button Content="打开录像目录"
                          MinHeight="38"
                          HorizontalAlignment="Stretch"
                          Click="OpenDownloadRootButton_Click" />
                  <TextBlock Classes="caption"
                             Text="目录结构与 HelloCrab 一致：Download / 平台 / 昵称(作者ID) / yyyy-MM-dd HH-mm-ss.flv"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="远程控制服务器" FontSize="18" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="允许 Android / iOS / Browser 遥控" FontWeight="Medium" />
                      <TextBlock Classes="caption"
                                 Text="移动端与 Browser 端只作为远程控制器，不在本机运行 Playwright 或直播监控任务。"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding RemoteApiEnabled, Mode=TwoWay}"
                                  OnContent="开"
                                  OffContent="关"
                                  VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="服务端口" FontWeight="Medium" />
                      <TextBlock Classes="caption" Text="修改端口后，已启用的服务器会自动重启。" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1"
                                   Minimum="1024"
                                   Maximum="65535"
                                   Increment="1"
                                   Value="{Binding RemoteApiPort, Mode=TwoWay}" />
                  </Grid>
                  <TextBlock Classes="caption" Text="访问令牌" />
                  <TextBox Text="{Binding RemoteApiToken, Mode=OneWay}"
                           IsReadOnly="True"
                           FontFamily="Consolas,Menlo,Monospace"
                           TextWrapping="Wrap"
                           MinHeight="40" />
                  <TextBlock Classes="caption"
                             Text="{Binding RemoteApiStatusText}"
                             TextWrapping="Wrap" />
                  <TextBlock Classes="caption"
                             Text="手机请填写上面状态中显示的局域网地址；Browser 端也通过同一 HTTP API 遥控桌面 HelloLive。"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="平台适配器" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Classes="caption"
                             Text="当前已实现快手。平台识别、网络流识别和 JSON 播放地址解析均通过 ILivePlatformAdapter 隔离；后续分析抖音等平台时无需修改监控调度和 UI 主流程。"
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Platforms}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <Border Margin="0,4,0,0" Padding="10,7" CornerRadius="7" Background="#18FFFFFF">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Id}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="14">
            <UniformGrid Columns="6">
              <Border Classes="metricCard" Margin="0,0,7,0"><StackPanel><TextBlock Classes="caption" Text="监控总数"/><TextBlock Classes="metric" Text="{Binding MonitorCount}" Foreground="#8B5CF6"/></StackPanel></Border>
              <Border Classes="metricCard" Margin="0,0,7,0"><StackPanel><TextBlock Classes="caption" Text="已启用"/><TextBlock Classes="metric" Text="{Binding EnabledCount}" Foreground="#06B6D4"/></StackPanel></Border>
              <Border Classes="metricCard" Margin="0,0,7,0"><StackPanel><TextBlock Classes="caption" Text="直播中"/><TextBlock Classes="metric" Text="{Binding LiveCount}" Foreground="#10B981"/></StackPanel></Border>
              <Border Classes="metricCard" Margin="0,0,7,0"><StackPanel><TextBlock Classes="caption" Text="未检测到"/><TextBlock Classes="metric" Text="{Binding NotDetectedCount}" Foreground="#F59E0B"/></StackPanel></Border>
              <Border Classes="metricCard" Margin="0,0,7,0"><StackPanel><TextBlock Classes="caption" Text="检查中"/><TextBlock Classes="metric" Text="{Binding CheckingCount}" Foreground="#EC4899"/></StackPanel></Border>
              <Border Classes="metricCard"><StackPanel><TextBlock Classes="caption" Text="失败"/><TextBlock Classes="metric" Text="{Binding FailedCount}" Foreground="#F43F5E"/></StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="1" Classes="card">
              <Grid ColumnDefinitions="88,8,*" ColumnSpacing="12">
                <Border Width="88" Height="88" CornerRadius="44" Background="#22FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                  <TextBlock Text="LIVE" Foreground="#FD6F71" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="1" Width="8" CornerRadius="3" Background="#A78BFA" />
                <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Classes="caption" Text="当前状态" />
                  <TextBlock Text="{Binding MonitoringStatusText}" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CurrentTask}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="1 个 Chromium · 临时 Page · 有限并发" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="2" Classes="card">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="运行日志" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="最新在上 · 最多保留 500 条" />
                </Grid>
                <ScrollViewer Grid.Row="1"
                              Margin="0,12,-18,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Logs}" Margin="0,0,18,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="8,5" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Column="1"
                Width="430"
                Margin="0,0,8,0"
                Classes="card"
                IsVisible="{Binding IsMonitorPanelVisible}">
          <Grid RowDefinitions="Auto,Auto,*">
            <StackPanel>
              <TextBlock Text="监控列表" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Classes="caption"
                         Text="作者头像、身份、直播状态与录像状态集中显示；双击打开录像文件夹，右键打开操作菜单。"
                         Margin="0,3,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Background="#1FFFFFFF" CornerRadius="7" Padding="10,8" Margin="0,12,0,10">
              <TextBlock Classes="caption"
                         Text="流地址通常带时效签名。HelloLive 只读取普通公开页面正常产生的网络请求，不绕过登录、验证码或私密访问控制。"
                         TextWrapping="Wrap" />
            </Border>

            <ListBox Grid.Row="2"
                     Margin="0,0,-18,0"
                     Classes="monitorList"
                     ItemsSource="{Binding Monitors}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <Border Background="{DynamicResource MonitorItemColor}"
                          BorderBrush="{DynamicResource BorderColor}"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12"
                          Cursor="Hand"
                          PointerPressed="MonitorItem_PointerPressed">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="立即检查"
                                  Tag="{Binding}"
                                  Click="CheckTargetButton_Click" />
                        <MenuItem Header="复制直播流"
                                  Tag="{Binding}"
                                  IsEnabled="{Binding HasStreamUrl}"
                                  Click="CopyStreamButton_Click" />
                        <MenuItem Header="打开主页"
                                  Tag="{Binding}"
                                  Click="OpenProfileButton_Click" />
                        <MenuItem Header="修改 URL"
                                  Tag="{Binding}"
                                  Click="EditMonitorUrlButton_Click" />
                        <Separator />
                        <MenuItem Header="移除监控"
                                  Tag="{Binding}"
                                  Click="RemoveMonitorButton_Click" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="58,*,Auto" ColumnSpacing="10">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="27"
                                ClipToBounds="True"
                                Background="#1E7C3AED"
                                BorderBrush="#427C3AED"
                                BorderThickness="1">
                          <Grid>
                            <TextBlock Text="{Binding AvatarInitial}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#7C3AED"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding AvatarImage}"
                                   Stretch="UniformToFill"
                                   Width="54"
                                   Height="54" />
                          </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption"
                                     Text="{Binding AuthorIdText}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption"
                                     Text="{Binding ProfileUrl}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="7"
                                    HorizontalAlignment="Right">
                          <Border Padding="8,3"
                                  CornerRadius="9"
                                  Background="#267C3AED"
                                  BorderBrush="#557C3AED"
                                  BorderThickness="1"
                                  HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PlatformText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#7C3AED" />
                          </Border>
                          <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                        OnContent=""
                                        OffContent=""
                                        HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>

                      <Border Background="#0C7C3AED"
                              CornerRadius="9"
                              Padding="10,8">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                            <TextBlock Text="{Binding StateIcon}"
                                       FontSize="16"
                                       Foreground="#10B981"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StateText}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    Padding="7,2"
                                    CornerRadius="7"
                                    Background="#1606B6D4"
                                    IsVisible="{Binding HasStreamUrl}">
                              <TextBlock Text="{Binding StreamFormat}"
                                         FontSize="10"
                                         FontWeight="SemiBold"
                                         Foreground="#0891B2" />
                            </Border>
                          </Grid>
                          <TextBlock Classes="caption"
                                     Text="{Binding StatusMessage}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="caption"
                                     Text="{Binding LastCheckedText}" />
                        </StackPanel>
                      </Border>

                      <Border Background="#1210B981"
                              BorderBrush="#3010B981"
                              BorderThickness="1"
                              CornerRadius="9"
                              Padding="9,7"
                              IsVisible="{Binding IsRecording}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <Border Width="8"
                                  Height="8"
                                  CornerRadius="4"
                                  Background="#10B981"
                                  VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding RecordingStatus}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#10B981"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="caption"
                                       Text="{Binding RecordingFileName, StringFormat='录像文件 · {0}'}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>

                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <!-- 修改监控 URL：使用与主窗口一致的卡片、颜色和按钮风格。 -->
      <Grid x:Name="EditUrlOverlay"
            Grid.RowSpan="2"
            Background="#99000000"
            IsVisible="False"
            Panel.ZIndex="3000">
        <Border Width="570"
                Padding="24"
                CornerRadius="12"
                Background="{DynamicResource CardColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <StackPanel Spacing="6">
              <TextBlock Text="修改监控 URL"
                         FontSize="21"
                         FontWeight="SemiBold" />
              <TextBlock x:Name="EditUrlTargetText"
                         Classes="caption"
                         TextWrapping="Wrap" />
              <TextBlock Text="修改后会停止该条目的当前录像，清除旧作者身份与头像，并立即重新检查新地址。"
                         Classes="caption"
                         TextWrapping="Wrap" />
            </StackPanel>

            <TextBox x:Name="EditUrlTextBox"
                     MinHeight="44"
                     Padding="12,0"
                     VerticalContentAlignment="Center"
                     Watermark="https://live.kuaishou.com/profile/..."
                     KeyDown="EditUrlTextBox_KeyDown" />

            <TextBlock x:Name="EditUrlErrorText"
                       Foreground="#EF4444"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Content="取消"
                      MinHeight="40"
                      Click="EditUrlCancelButton_Click" />
              <Button Grid.Column="1"
                      Classes="primary"
                      Content="保存并检查"
                      MinHeight="40"
                      Click="EditUrlConfirmButton_Click" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 关闭确认：正常退出前先安全停止录像，也可最小化到托盘继续监控。 -->
      <Grid x:Name="CloseConfirmOverlay"
            Grid.RowSpan="2"
            Background="#99000000"
            IsVisible="False"
            Panel.ZIndex="3100">
        <Border Width="560"
                Padding="24"
                CornerRadius="12"
                Background="{DynamicResource CardColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="17">
            <StackPanel Spacing="6">
              <TextBlock Text="确认退出？"
                         FontSize="21"
                         FontWeight="SemiBold" />
              <TextBlock Text="确认退出后，当前直播监控和录像任务将安全停止；选择最小化到托盘则继续在后台运行。"
                         Classes="caption"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <Button Content="取消"
                      MinHeight="42"
                      Click="CloseCancelButton_Click" />
              <Button Grid.Column="1"
                      Classes="primary"
                      Content="最小化到托盘"
                      MinHeight="42"
                      Click="CloseMinimizeToTrayButton_Click" />
              <Button Grid.Column="2"
                      Classes="coral"
                      Content="确认退出"
                      MinHeight="42"
                      Click="CloseConfirmButton_Click" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
