<UserControl
    x:Class="HelloLive.Core.Remote.Views.RemoteMainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HelloLive.Core.Remote.ViewModels"
    xmlns:controls="using:HelloLive.Core.Controls"
    x:DataType="vm:RemoteMainViewModel"
    SizeChanged="RemoteMainView_SizeChanged">

  <Grid Background="{DynamicResource RemoteBackgroundBrush}">

    <!-- Desktop browser: mirror the desktop HelloLive information architecture. -->
    <Grid IsVisible="{Binding IsDesktopLayout}"
          RowDefinitions="Auto,*">

      <Grid Grid.Row="0"
            Margin="22,14,22,0"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">
        <Border Width="50"
                Height="50"
                CornerRadius="10"
                Background="#20FFFFFF"
                Padding="4"
                ClipToBounds="True"
                VerticalAlignment="Center">
          <controls:LiveLogo />
        </Border>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">
          <TextBlock Text="HelloLive Remote"
                     FontSize="23"
                     FontWeight="Bold" />
          <TextBlock Classes="caption"
                     Text="Browser · 桌面 HelloLive 远程控制"
                     Margin="0,2,0,0" />
        </StackPanel>

        <Button Grid.Column="2"
                Width="40"
                Height="40"
                Padding="0"
                CornerRadius="20"
                Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="切换远程端主题"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding ThemeIcon}"
                     FontSize="17"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Button>
      </Grid>

      <Grid Grid.Row="1"
            Margin="20,14,20,20"
            ColumnDefinitions="400,*,430"
            ColumnSpacing="16">

        <!-- Left column -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14"
                      Margin="0,0,4,0">

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="连接桌面端"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Classes="caption"
                           Text="{Binding ConnectionHint}"
                           TextWrapping="Wrap" />
                <TextBox Text="{Binding ServerAddress, Mode=TwoWay}"
                         PlaceholderText="http://192.168.1.100:5088"
                         MinHeight="42"
                         VerticalContentAlignment="Center" />
                <TextBox Text="{Binding AccessToken, Mode=TwoWay}"
                         PlaceholderText="访问令牌"
                         MinHeight="42"
                         VerticalContentAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <Button Classes="action primary"
                          HorizontalAlignment="Stretch"
                          Content="连接 / 重新连接"
                          Command="{Binding ConnectCommand}" />
                  <Button Grid.Column="1"
                          Classes="action"
                          HorizontalAlignment="Stretch"
                          Content="刷新"
                          Command="{Binding RefreshCommand}" />
                </Grid>
                <TextBlock Text="{Binding ConnectionText}"
                           Classes="caption"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="添加监控"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Classes="caption"
                           Text="添加作者主页、直播间地址或分享链接到桌面 HelloLive。"
                           TextWrapping="Wrap" />
                <TextBox Text="{Binding NewMonitorUrl, Mode=TwoWay}"
                         PlaceholderText="作者主页或直播分享地址"
                         MinHeight="42"
                         VerticalContentAlignment="Center" />
                <TextBox Text="{Binding NewMonitorName, Mode=TwoWay}"
                         PlaceholderText="备注名称（可选）"
                         MinHeight="42"
                         VerticalContentAlignment="Center" />
                <Button Classes="action primary"
                        HorizontalAlignment="Stretch"
                        Content="添加到桌面监控列表"
                        Command="{Binding AddMonitorCommand}" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="远程控制"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding MonitoringStatusText}"
                           FontWeight="Medium" />
                <TextBlock Classes="caption"
                           Text="{Binding CurrentTask}"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Button Classes="action coral"
                          HorizontalAlignment="Stretch"
                          Content="开始监控"
                          Command="{Binding StartMonitoringCommand}" />
                  <Button Grid.Column="1"
                          Classes="action"
                          HorizontalAlignment="Stretch"
                          Content="停止监控"
                          Command="{Binding StopMonitoringCommand}" />
                  <Button Grid.Column="2"
                          Classes="action primary"
                          HorizontalAlignment="Stretch"
                          Content="检查全部"
                          Command="{Binding CheckAllCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Center column -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="14">

          <UniformGrid Columns="6">
            <Border Classes="card" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Classes="caption" Text="监控总数" />
                <TextBlock Text="{Binding MonitorCount}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#8B5CF6" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Classes="caption" Text="已启用" />
                <TextBlock Text="{Binding EnabledCount}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#06B6D4" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Classes="caption" Text="直播中" />
                <TextBlock Text="{Binding LiveCount}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#10B981" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Classes="caption" Text="未检测到" />
                <TextBlock Text="{Binding NotDetectedCount}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#F59E0B" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Classes="caption" Text="检查中" />
                <TextBlock Text="{Binding CheckingCount}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#EC4899" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Classes="caption" Text="失败" />
                <TextBlock Text="{Binding FailedCount}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#F43F5E" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="1"
                  Classes="card">
            <Grid ColumnDefinitions="88,8,*"
                  ColumnSpacing="12">
              <Border Width="88"
                      Height="88"
                      CornerRadius="44"
                      Background="#20FFFFFF"
                      BorderBrush="{DynamicResource RemoteCardBorderBrush}"
                      BorderThickness="1">
                <TextBlock Text="LIVE"
                           Foreground="#FD6F71"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <Border Grid.Column="1"
                      Width="8"
                      CornerRadius="3"
                      Background="#A78BFA" />
              <StackPanel Grid.Column="2"
                          Spacing="5"
                          VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="当前状态" />
                <TextBlock Text="{Binding MonitoringStatusText}"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <controls:EmojiTextBlock Text="{Binding CurrentTask}"
                                         FontSize="14" />
                <TextBlock Classes="caption"
                           Text="{Binding ConnectionText}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2"
                  Classes="card">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="运行日志"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Classes="caption"
                           Text="桌面端最新日志"
                           VerticalAlignment="Center" />
              </Grid>
              <ScrollViewer Grid.Row="1"
                            Margin="0,12,-12,0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Logs}"
                              Margin="0,0,12,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                      <TextBlock Text="{Binding}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Margin="6,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Right column -->
        <Border Grid.Column="2"
                Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="监控列表"
                           FontSize="19"
                           FontWeight="SemiBold" />
                <TextBlock Classes="caption"
                           Text="集中查看桌面端作者状态并执行远程操作。"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Classes="caption"
                         Text="{Binding MonitorCount, StringFormat='共 {0} 项'}"
                         VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,0,-12,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Monitors}"
                            Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Border Margin="0,0,0,10"
                            Padding="12"
                            CornerRadius="12"
                            Background="{DynamicResource RemoteItemBrush}"
                            BorderBrush="{DynamicResource RemoteCardBorderBrush}"
                            BorderThickness="1">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                          <StackPanel>
                            <controls:EmojiTextBlock Text="{Binding DisplayName}"
                                                     FontSize="16"
                                                     FontWeight="SemiBold" />
                            <TextBlock Classes="caption"
                                       Text="{Binding AuthorId, StringFormat='作者ID：{0}'}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption"
                                       Text="{Binding ProfileUrl}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="6"
                                      HorizontalAlignment="Right">
                            <Border Padding="7,3"
                                    CornerRadius="8"
                                    Background="#267C3AED">
                              <TextBlock Text="{Binding PlatformText}"
                                         FontSize="11" />
                            </Border>
                            <CheckBox IsChecked="{Binding IsEnabled}"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8">
                          <TextBlock Text="{Binding StateText}"
                                     FontWeight="SemiBold" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Classes="caption"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="caption"
                                       Text="{Binding LastCheckedText}" />
                            <TextBlock Text="{Binding RecordingStatus}"
                                       FontWeight="SemiBold"
                                       Foreground="#10B981"
                                       IsVisible="{Binding IsRecording}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="6">
                          <Button Classes="action"
                                  Content="检查"
                                  Tag="{Binding}"
                                  Click="CheckMonitor_Click" />
                          <Button Grid.Column="1"
                                  Classes="action"
                                  Content="启用 / 停用"
                                  Tag="{Binding}"
                                  Click="ToggleMonitor_Click" />
                          <Button Grid.Column="2"
                                  Classes="action"
                                  Content="移除"
                                  Tag="{Binding}"
                                  Click="RemoveMonitor_Click" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Mobile / narrow browser keeps the existing touch-oriented single-column layout. -->
    <ScrollViewer IsVisible="{Binding IsCompactLayout}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="18,18,18,28"
                  Spacing="14"
                  MaxWidth="920"
                  HorizontalAlignment="Center">

        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              Margin="2,0">
          <Border Width="52"
                  Height="52"
                  CornerRadius="13"
                  Background="#20FFFFFF"
                  Padding="4"
                  ClipToBounds="True"
                  VerticalAlignment="Center">
            <controls:LiveLogo />
          </Border>
          <StackPanel Grid.Column="1"
                      VerticalAlignment="Center">
            <TextBlock Text="HelloLive Remote"
                       FontSize="26"
                       FontWeight="Bold" />
            <TextBlock Classes="caption"
                       Text="Android · iOS · Browser 仅作为桌面 HelloLive 的远程遥控端"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2"
                  Width="44"
                  Height="44"
                  Padding="0"
                  CornerRadius="22"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="切换远程端主题">
            <TextBlock Text="{Binding ThemeIcon}"
                       FontSize="17" />
          </Button>
        </Grid>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="连接桌面端"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Classes="caption"
                       Text="{Binding ConnectionHint}"
                       TextWrapping="Wrap" />
            <TextBox Text="{Binding ServerAddress, Mode=TwoWay}"
                     PlaceholderText="http://192.168.1.100:5088"
                     MinHeight="42"
                     VerticalContentAlignment="Center" />
            <TextBox Text="{Binding AccessToken, Mode=TwoWay}"
                     PlaceholderText="访问令牌"
                     MinHeight="42"
                     VerticalContentAlignment="Center" />
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
              <Button Classes="action primary"
                      Content="连接 / 重新连接"
                      Command="{Binding ConnectCommand}" />
              <Button Grid.Column="1"
                      Classes="action"
                      Content="刷新"
                      Command="{Binding RefreshCommand}" />
            </Grid>
            <TextBlock Text="{Binding ConnectionText}"
                       Classes="caption"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <UniformGrid Columns="3">
          <Border Classes="card" Margin="0,0,7,7">
            <StackPanel>
              <TextBlock Classes="caption" Text="监控总数" />
              <TextBlock Text="{Binding MonitorCount}" FontSize="25" FontWeight="Bold" Foreground="#8B5CF6" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,7,7">
            <StackPanel>
              <TextBlock Classes="caption" Text="已启用" />
              <TextBlock Text="{Binding EnabledCount}" FontSize="25" FontWeight="Bold" Foreground="#06B6D4" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,0,7">
            <StackPanel>
              <TextBlock Classes="caption" Text="直播中" />
              <TextBlock Text="{Binding LiveCount}" FontSize="25" FontWeight="Bold" Foreground="#10B981" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,7,0">
            <StackPanel>
              <TextBlock Classes="caption" Text="未检测到" />
              <TextBlock Text="{Binding NotDetectedCount}" FontSize="25" FontWeight="Bold" Foreground="#F59E0B" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,7,0">
            <StackPanel>
              <TextBlock Classes="caption" Text="检查中" />
              <TextBlock Text="{Binding CheckingCount}" FontSize="25" FontWeight="Bold" Foreground="#EC4899" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="caption" Text="失败" />
              <TextBlock Text="{Binding FailedCount}" FontSize="25" FontWeight="Bold" Foreground="#F43F5E" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="远程控制" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding MonitoringStatusText}" FontWeight="Medium" />
            <controls:EmojiTextBlock Text="{Binding CurrentTask}"
                                     FontSize="12"
                                     Foreground="{DynamicResource RemoteCaptionBrush}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
              <Button Classes="action coral"
                      Content="开始监控"
                      Command="{Binding StartMonitoringCommand}" />
              <Button Grid.Column="1"
                      Classes="action"
                      Content="停止监控"
                      Command="{Binding StopMonitoringCommand}" />
              <Button Grid.Column="2"
                      Classes="action primary"
                      Content="检查全部"
                      Command="{Binding CheckAllCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="添加监控" FontSize="18" FontWeight="SemiBold" />
            <TextBox Text="{Binding NewMonitorUrl, Mode=TwoWay}"
                     PlaceholderText="作者主页或直播分享地址"
                     MinHeight="42"
                     VerticalContentAlignment="Center" />
            <TextBox Text="{Binding NewMonitorName, Mode=TwoWay}"
                     PlaceholderText="备注名称（可选）"
                     MinHeight="42"
                     VerticalContentAlignment="Center" />
            <Button Classes="action primary"
                    Content="添加到桌面监控列表"
                    Command="{Binding AddMonitorCommand}" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="监控列表" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1"
                         Classes="caption"
                         Text="{Binding MonitorCount, StringFormat='共 {0} 项'}"
                         VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Monitors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <Border Margin="0,0,0,9"
                          Padding="11"
                          CornerRadius="10"
                          Background="{DynamicResource RemoteItemBrush}"
                          BorderBrush="{DynamicResource RemoteCardBorderBrush}"
                          BorderThickness="1">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel>
                          <controls:EmojiTextBlock Text="{Binding DisplayName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                          <TextBlock Classes="caption"
                                     Text="{Binding AuthorId, StringFormat='作者ID：{0}'}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption"
                                     Text="{Binding ProfileUrl}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="7,3"
                                CornerRadius="8"
                                Background="#267C3AED">
                          <TextBlock Text="{Binding PlatformText}"
                                     FontSize="11" />
                        </Border>
                      </Grid>

                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding IsEnabled}"
                                  IsHitTestVisible="False"
                                  VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding StateText}" FontWeight="Medium" />
                          <TextBlock Classes="caption"
                                     Text="{Binding StatusMessage}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="caption" Text="{Binding LastCheckedText}" />
                          <TextBlock Classes="caption"
                                     Text="{Binding StreamFormat, StringFormat='流格式：{0}'}" />
                          <TextBlock Text="{Binding RecordingStatus}"
                                     FontWeight="SemiBold"
                                     Foreground="#10B981"
                                     IsVisible="{Binding IsRecording}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="caption"
                                     Text="{Binding RecordingFilePath, StringFormat='录像：{0}'}"
                                     IsVisible="{Binding IsRecording}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>

                      <Grid ColumnDefinitions="*,*,*"
                            ColumnSpacing="6">
                        <Button Classes="action"
                                Content="检查"
                                Tag="{Binding}"
                                Click="CheckMonitor_Click" />
                        <Button Grid.Column="1"
                                Classes="action"
                                Content="启用 / 停用"
                                Tag="{Binding}"
                                Click="ToggleMonitor_Click" />
                        <Button Grid.Column="2"
                                Classes="action"
                                Content="移除"
                                Tag="{Binding}"
                                Click="RemoveMonitor_Click" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="桌面端日志"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Logs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <TextBlock Text="{Binding}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Margin="0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
